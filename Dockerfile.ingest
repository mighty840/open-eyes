# Ingest CLI image
FROM rust:1.84-bookworm AS builder

WORKDIR /app
COPY . .

RUN cargo build --release -p open-eyes-ingest

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/open-eyes-ingest /app/open-eyes-ingest
COPY config.toml /app/config.toml

RUN mkdir -p /app/data

ENV OPEN_EYES_CONFIG=/app/config.toml

ENTRYPOINT ["/app/open-eyes-ingest", "--config", "/app/config.toml"]
